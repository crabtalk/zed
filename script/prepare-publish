#!/usr/bin/env python3
"""Rewrite the gpui crate closure for publication under the bezel-gpui-* namespace.

Run on a `release` branch freshly cut from `dev`; the branch is generated output,
never rebased. Usage: script/prepare-publish <version> [--dry-run]
"""

import json
import re
import subprocess
import sys
from pathlib import Path

ROOTS = ("gpui", "gpui_platform", "gpui_web")
PREFIX = "bezel"
FORK = "https://github.com/crabtalk/zed"
UPSTREAM = "https://github.com/zed-industries/zed"
COPYRIGHT = "Copyright 2022 - 2025 Zed Industries, Inc."
MARKER = "> **NOTICE**"


def notice(name, base):
    """Apache-2.0 section 4(b): modified files must say they were modified."""
    return f"""{MARKER}
>
> `{published(name)}` is a modified distribution of `{name}` from [zed-industries/zed]({UPSTREAM}) — {COPYRIGHT}, licensed under the Apache License, Version 2.0.
>
> Modified by the bezel project; the modifications and their full source are at [crabtalk/zed]({FORK}), based on upstream `{base}`.
"""


def published(name):
    """gpui -> bezel-gpui, gpui_util -> bezel-gpui-util, util -> bezel-zed-util.

    Two namespaces, disjoint by construction: zed carries both `util` and
    `gpui_util`, which collide under any single-prefix rule.
    """
    if name == "gpui":
        return f"{PREFIX}-gpui"
    if name.startswith("gpui_"):
        return f"{PREFIX}-gpui-{name[len('gpui_'):].replace('_', '-')}"
    return f"{PREFIX}-zed-{name.replace('_', '-')}"


# A git dependency with a `version` silently republishes as that registry crate.
# zed's wasm_thread fork fixes a worker bootstrap that the registry 0.3.3 still
# gets wrong, and the fork is not on crates.io — so shipping this feature would
# compile against one crate and run against another.
UNPUBLISHABLE = {
    "gpui_web": ("multithreaded", "wasm_thread"),
    # `util` reaches a forked async-process through [patch.crates-io], which
    # publication strips — the published crate would compile against registry
    # async-process, which has no `adopt_raw_pid`. The feature downloads GitHub
    # releases; nothing gpui needs.
    "http_client": ("github-download", "util"),
}

# Crates that leave the closure once the edges above are cut.
EXCLUDE = {"util"}


def strip_dev_deps(text):
    """Published manifests carry no dev-dependencies.

    gpui dev-depends on gpui_platform and gpui_web, which depend on gpui; once
    the rewrite gives those entries a version, cargo demands they already exist
    on the registry and no publish order can satisfy the cycle.
    """
    out, skipping = [], False
    for line in text.splitlines(keepends=True):
        if line.startswith("["):
            skipping = bool(re.match(r"^\[(target\.[^\]]*\.)?dev-dependencies\]", line))
        if not skipping:
            out.append(line)
    return "".join(out)


# Git pins on the crate's own upstream repo, just at an unreleased commit — the
# registry crate is the same project, so a version substitutes cleanly. A pin on
# someone's *fork* must never be substituted; that is what UNPUBLISHABLE is for.
SUBSTITUTE = {"proptest": 'version = "1", features = ["attr-macro"]'}


def versionless_git_deps(root_text):
    """Workspace deps declared by git with no version — cargo refuses to publish
    a manifest that references one, even optionally."""
    return {m.group(1) for m in re.finditer(r"^([A-Za-z0-9_-]+) = \{([^}]*)\}$",
                                            root_text, flags=re.M)
            if "git = " in m.group(2) and "version = " not in m.group(2)} - set(SUBSTITUTE)


def drop_versionless(text, name, versionless):
    """Remove optional deps on versionless git crates, and their feature refs."""
    for dep in sorted(versionless):
        pattern = rf"^{re.escape(dep)} = \{{[^}}]*optional = true[^}}]*\}}\n"
        if not re.search(pattern, text, flags=re.M):
            continue
        text = re.sub(pattern, "", text, flags=re.M)
        text = re.sub(rf'"(?:dep:)?{re.escape(dep)}",? ?', "", text)
        print(f"  ! dropped {name} optional dep {dep} — no publishable version")
    return text


def drop_unpublishable(text, name):
    if name not in UNPUBLISHABLE:
        return text
    feature, dep = UNPUBLISHABLE[name]
    text = re.sub(rf'^(default = \[)"{feature}"(, )?', r"\1", text, flags=re.M)
    # Emptied, not deleted: unpublished workspace members still name these
    # features, and `cargo publish -p X` resolves the whole workspace.
    text = re.sub(rf"^{feature} = \[[^\]]*\]", f"{feature} = []", text, flags=re.M)
    text = re.sub(rf"^(# [^\n]*\n)*{dep} = \{{[^}}]*\}}\n", "", text, flags=re.M)
    print(f"  ! dropped {name}:{feature} — {dep} is not publishable")
    return text


def stub(name):
    """A README for a crate that upstream never gave one; crates.io shows this page."""
    return f"""# {published(name)}

`{name}` from [zed-industries/zed]({UPSTREAM}), republished from the bezel project's fork so that the fork resolves from crates.io rather than from a git dependency.

See [`bezel-gpui`](https://crates.io/crates/bezel-gpui) for the fork's entry point, and [crabtalk/zed]({FORK}) for the source and its patch queue.
"""


def closure(root):
    """Workspace members reachable from ROOTS across every target.

    Dev-dependencies are excluded: they are stripped from a published manifest,
    and following them drags in `util`/`path`, which collide with `gpui_util`.
    """
    meta = json.loads(
        subprocess.run(
            ["cargo", "metadata", "--locked", "--format-version", "1"],
            cwd=root, capture_output=True, text=True, check=True,
        ).stdout
    )
    members = set(meta["workspace_members"])
    by_id = {p["id"]: p for p in meta["packages"]}
    deps = {
        n["id"]: [
            d["pkg"] for d in n["deps"]
            if any(k["kind"] != "dev" for k in d["dep_kinds"])
        ]
        for n in meta["resolve"]["nodes"]
    }

    seen, stack = set(), [i for i in members if by_id[i]["name"] in ROOTS]
    while stack:
        pkg = stack.pop()
        if pkg in seen or pkg not in members:
            continue
        seen.add(pkg)
        stack.extend(deps.get(pkg, []))

    seen = {p for p in seen if by_id[p]["name"] not in EXCLUDE}

    taken = {}
    for pkg in seen:
        name = by_id[pkg]["name"]
        if published(name) in taken:
            sys.exit(f"name collision: {name} and {taken[published(name)]} "
                     f"both publish as {published(name)}")
        taken[published(name)] = name

    edges = {by_id[i]["name"]: [by_id[d]["name"] for d in deps[i] if d in seen]
             for i in seen}
    outside = sorted({by_id[i]["name"] for i in members} - {by_id[i]["name"] for i in seen})
    return ({by_id[i]["name"]: Path(by_id[i]["manifest_path"]) for i in seen},
            edges, outside)


def publish_order(edges):
    """Depth-first post-order: every crate lands after everything it depends on."""
    order, seen = [], set()

    def visit(name):
        if name in seen:
            return
        seen.add(name)
        for dep in sorted(edges[name]):
            visit(dep)
        order.append(name)

    for name in sorted(edges):
        visit(name)
    return order


def ensure(text, field, value, overwrite):
    """Set a [package] field, whether or not upstream declared one."""
    line = f'{field} = "{value}"'
    if re.search(rf"^{field}(\.workspace)? *=", text, flags=re.M):
        return re.sub(rf"^{field}(\.workspace)? *= *.*$", line, text,
                      count=1, flags=re.M) if overwrite else text
    return re.sub(r'^(version = "[^"]*")$', rf"\1\n{line}", text, count=1, flags=re.M)


def rewrite_member(text, name, version, versionless):
    """Publish under the prefixed name; keep the lib name so no source changes."""
    text = re.sub(rf'^name = "{re.escape(name)}"$',
                  f'name = "{published(name)}"', text, count=1, flags=re.M)
    text = re.sub(r'^version = "[^"]*"$',
                  f'version = "{version}"', text, count=1, flags=re.M)
    # Drop any publish setting so the crate takes cargo's publishable default:
    # zed's [workspace.package] is `publish = false`, and most crates inherit it.
    text = re.sub(r"^publish(\.workspace)? *= *(false|true)\n", "", text,
                  count=1, flags=re.M)

    # crates.io rejects a crate with no description or license, and most of these
    # are internal crates upstream never had to fill in.
    text = ensure(text, "repository", FORK, overwrite=True)
    text = ensure(text, "readme", "README.md", overwrite=False)
    text = ensure(text, "license", "Apache-2.0", overwrite=False)
    text = ensure(text, "description",
                  f"{name} from zed-industries/zed, republished for the bezel gpui fork",
                  overwrite=False)

    text = drop_unpublishable(text, name)
    text = drop_versionless(text, name, versionless)
    text = strip_dev_deps(text)

    if re.search(r"^\[lib\]$", text, flags=re.M):
        if not re.search(r"^\[lib\]\n(?:[a-z-]+ = .*\n)*?name = ", text, flags=re.M):
            text = re.sub(r"^\[lib\]$", f'[lib]\nname = "{name}"', text,
                          count=1, flags=re.M)
    else:
        text = re.sub(r"^\[dependencies\]$", f'[lib]\nname = "{name}"\n\n[dependencies]',
                      text, count=1, flags=re.M)
    return text


def rewrite_root(text, names, version, outside):
    """Point each workspace dep at the published name; path deps need a version.

    `[workspace.package]` also gains the version: conta reads it from there to
    decide which crates are already on crates.io, and upstream has none.
    """
    text = re.sub(r"^\[workspace\.package\]\n",
                  f'[workspace.package]\nversion = "{version}"\n',
                  text, count=1, flags=re.M)

    for name in names:
        pattern = rf'^{re.escape(name)} = \{{([^}}]*)\}}$'
        match = re.search(pattern, text, flags=re.M)
        if not match:
            print(f"  ! no workspace dep entry for {name}", file=sys.stderr)
            continue
        body = match.group(1).strip().rstrip(",")
        body = re.sub(r'\s*version = "[^"]*",?', "", body).strip().rstrip(",")
        entry = f'{name} = {{ package = "{published(name)}", {body}, version = "{version}" }}'
        text = text[: match.start()] + entry + text[match.end():]

    for dep, spec in SUBSTITUTE.items():
        text = re.sub(rf"^{re.escape(dep)} = \{{[^}}]*\}}$", f"{dep} = {{ {spec} }}",
                      text, count=1, flags=re.M)

    # Every workspace member outside the closure, named explicitly: conta only
    # skips `publish = false` crates, and zed has members that set publish=true
    # and would otherwise go up unrenamed. (It also panics if this table is
    # missing, so it has to be written either way.)
    listed = ",\n    ".join(f'"{n}"' for n in outside)
    text += f"\n[workspace.metadata.conta]\nignore = [\n    {listed},\n]\n"
    return text


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    if len(args) != 1:
        sys.exit(__doc__)
    dry = "--dry-run" in sys.argv

    root = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"],
                               capture_output=True, text=True, check=True).stdout.strip())

    # The release is anchored to the upstream commit it forks from, not to our
    # own tip: `+zed.<base>` says which zed this is, the way openssl-src's
    # `+3.6.3` names the OpenSSL it wraps. Abbreviation is git's, not a fixed
    # width, so it stays unambiguous as the repo grows.
    merge_base = subprocess.run(["git", "merge-base", "main", "dev"], cwd=root,
                                capture_output=True, text=True, check=True).stdout.strip()
    base = subprocess.run(["git", "rev-parse", "--short=6", merge_base], cwd=root,
                          capture_output=True, text=True, check=True).stdout.strip()
    version = f"{args[0].split('+')[0]}+zed.{base}"

    crates, edges, outside = closure(root)
    versionless = versionless_git_deps((root / 'Cargo.toml').read_text())
    print(f"{len(crates)} crates -> {PREFIX}-* @ {version}\n")

    for name, manifest in sorted(crates.items()):
        new = rewrite_member(manifest.read_text(), name, version, versionless)
        readme = manifest.parent / "README.md"
        body = readme.read_text() if readme.exists() else stub(name)
        header = notice(name, base)
        print(f"  {name:22} -> {published(name):28} "
              f"README {'prepend' if readme.exists() else 'create'}")
        if not dry:
            manifest.write_text(new)
            readme.write_text(f"{header}\n{body}" if MARKER not in body else body)

    root_manifest = root / "Cargo.toml"
    new_root = rewrite_root(root_manifest.read_text(), sorted(crates), version, outside)
    if not dry:
        root_manifest.write_text(new_root)

    print("\npublish order:")
    for i, name in enumerate(publish_order(edges), 1):
        print(f"  {i:2}. {published(name)}")
    if dry:
        print("\n(dry run — nothing written)")


if __name__ == "__main__":
    main()
