#!/usr/bin/env python3
"""Rewrite the gpui crate closure for publication under the bezel-gpui-* namespace.

Run on a `release` branch freshly cut from `dev`; the branch is generated output,
never rebased. Usage: script/prepare-publish <version> [--dry-run]
"""

import json
import re
import subprocess
import sys
from pathlib import Path

ROOTS = ("gpui", "gpui_platform", "gpui_web")
PREFIX = "bezel"
FORK = "https://github.com/crabtalk/zed"
UPSTREAM = "https://github.com/zed-industries/zed"
COPYRIGHT = "Copyright 2022 - 2025 Zed Industries, Inc."
MARKER = "> **NOTICE**"


def notice(name, base):
    """Apache-2.0 section 4(b): modified files must say they were modified."""
    return f"""{MARKER}
>
> `{published(name)}` is a modified distribution of `{name}` from [zed-industries/zed]({UPSTREAM}) — {COPYRIGHT}, licensed under the Apache License, Version 2.0.
>
> Modified by the bezel project; the modifications and their full source are at [crabtalk/zed]({FORK}), based on upstream `{base}`.
"""


def published(name):
    """gpui -> bezel-gpui, gpui_util -> bezel-gpui-util, util -> bezel-zed-util.

    Two namespaces, disjoint by construction: zed carries both `util` and
    `gpui_util`, which collide under any single-prefix rule.
    """
    if name == "gpui":
        return f"{PREFIX}-gpui"
    if name.startswith("gpui_"):
        return f"{PREFIX}-gpui-{name[len('gpui_'):].replace('_', '-')}"
    return f"{PREFIX}-zed-{name.replace('_', '-')}"


def stub(name):
    """A README for a crate that upstream never gave one; crates.io shows this page."""
    return f"""# {published(name)}

`{name}` from [zed-industries/zed]({UPSTREAM}), republished from the bezel project's fork so that the fork resolves from crates.io rather than from a git dependency.

See [`bezel-gpui`](https://crates.io/crates/bezel-gpui) for the fork's entry point, and [crabtalk/zed]({FORK}) for the source and its patch queue.
"""


def closure(root):
    """Workspace members reachable from ROOTS across every target.

    Dev-dependencies are excluded: they are stripped from a published manifest,
    and following them drags in `util`/`path`, which collide with `gpui_util`.
    """
    meta = json.loads(
        subprocess.run(
            ["cargo", "metadata", "--locked", "--format-version", "1"],
            cwd=root, capture_output=True, text=True, check=True,
        ).stdout
    )
    members = set(meta["workspace_members"])
    by_id = {p["id"]: p for p in meta["packages"]}
    deps = {
        n["id"]: [
            d["pkg"] for d in n["deps"]
            if any(k["kind"] != "dev" for k in d["dep_kinds"])
        ]
        for n in meta["resolve"]["nodes"]
    }

    seen, stack = set(), [i for i in members if by_id[i]["name"] in ROOTS]
    while stack:
        pkg = stack.pop()
        if pkg in seen or pkg not in members:
            continue
        seen.add(pkg)
        stack.extend(deps.get(pkg, []))

    taken = {}
    for pkg in seen:
        name = by_id[pkg]["name"]
        if published(name) in taken:
            sys.exit(f"name collision: {name} and {taken[published(name)]} "
                     f"both publish as {published(name)}")
        taken[published(name)] = name

    edges = {by_id[i]["name"]: [by_id[d]["name"] for d in deps[i] if d in seen]
             for i in seen}
    return {by_id[i]["name"]: Path(by_id[i]["manifest_path"]) for i in seen}, edges


def publish_order(edges):
    """Depth-first post-order: every crate lands after everything it depends on."""
    order, seen = [], set()

    def visit(name):
        if name in seen:
            return
        seen.add(name)
        for dep in sorted(edges[name]):
            visit(dep)
        order.append(name)

    for name in sorted(edges):
        visit(name)
    return order


def ensure(text, field, value, overwrite):
    """Set a [package] field, whether or not upstream declared one."""
    line = f'{field} = "{value}"'
    if re.search(rf"^{field}(\.workspace)? *=", text, flags=re.M):
        return re.sub(rf"^{field}(\.workspace)? *= *.*$", line, text,
                      count=1, flags=re.M) if overwrite else text
    return re.sub(r'^(version = "[^"]*")$', rf"\1\n{line}", text, count=1, flags=re.M)


def rewrite_member(text, name, version):
    """Publish under the prefixed name; keep the lib name so no source changes."""
    text = re.sub(rf'^name = "{re.escape(name)}"$',
                  f'name = "{published(name)}"', text, count=1, flags=re.M)
    text = re.sub(r'^version = "[^"]*"$',
                  f'version = "{version}"', text, count=1, flags=re.M)
    # Drop any publish setting so the crate takes cargo's publishable default:
    # zed's [workspace.package] is `publish = false`, and most crates inherit it.
    text = re.sub(r"^publish(\.workspace)? *= *(false|true)\n", "", text,
                  count=1, flags=re.M)

    # crates.io rejects a crate with no description or license, and most of these
    # are internal crates upstream never had to fill in.
    text = ensure(text, "repository", FORK, overwrite=True)
    text = ensure(text, "readme", "README.md", overwrite=False)
    text = ensure(text, "license", "Apache-2.0", overwrite=False)
    text = ensure(text, "description",
                  f"{name} from zed-industries/zed, republished for the bezel gpui fork",
                  overwrite=False)

    if re.search(r"^\[lib\]$", text, flags=re.M):
        if not re.search(r"^\[lib\]\n(?:[a-z-]+ = .*\n)*?name = ", text, flags=re.M):
            text = re.sub(r"^\[lib\]$", f'[lib]\nname = "{name}"', text,
                          count=1, flags=re.M)
    else:
        text = re.sub(r"^\[dependencies\]$", f'[lib]\nname = "{name}"\n\n[dependencies]',
                      text, count=1, flags=re.M)
    return text


def rewrite_root(text, names, version):
    """Point each workspace dep at the published name; path deps need a version."""
    for name in names:
        pattern = rf'^{re.escape(name)} = \{{([^}}]*)\}}$'
        match = re.search(pattern, text, flags=re.M)
        if not match:
            print(f"  ! no workspace dep entry for {name}", file=sys.stderr)
            continue
        body = match.group(1).strip().rstrip(",")
        body = re.sub(r'\s*version = "[^"]*",?', "", body).strip().rstrip(",")
        entry = f'{name} = {{ package = "{published(name)}", {body}, version = "{version}" }}'
        text = text[: match.start()] + entry + text[match.end():]
    return text


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    if len(args) != 1:
        sys.exit(__doc__)
    version, dry = args[0], "--dry-run" in sys.argv

    root = Path(subprocess.run(["git", "rev-parse", "--show-toplevel"],
                               capture_output=True, text=True, check=True).stdout.strip())
    crates, edges = closure(root)
    print(f"{len(crates)} crates -> {PREFIX}-* @ {version}\n")

    base = subprocess.run(["git", "merge-base", "main", "dev"], cwd=root,
                          capture_output=True, text=True, check=True).stdout.strip()[:10]

    for name, manifest in sorted(crates.items()):
        new = rewrite_member(manifest.read_text(), name, version)
        readme = manifest.parent / "README.md"
        body = readme.read_text() if readme.exists() else stub(name)
        header = notice(name, base)
        print(f"  {name:22} -> {published(name):28} "
              f"README {'prepend' if readme.exists() else 'create'}")
        if not dry:
            manifest.write_text(new)
            readme.write_text(f"{header}\n{body}" if MARKER not in body else body)

    root_manifest = root / "Cargo.toml"
    new_root = rewrite_root(root_manifest.read_text(), sorted(crates), version)
    if not dry:
        root_manifest.write_text(new_root)

    print("\npublish order:")
    for i, name in enumerate(publish_order(edges), 1):
        print(f"  {i:2}. {published(name)}")
    if dry:
        print("\n(dry run — nothing written)")


if __name__ == "__main__":
    main()
