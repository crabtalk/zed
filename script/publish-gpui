#!/usr/bin/env python3
"""Verify prepared GPUI packages; pass --publish to upload after verification."""

import argparse
import json
import subprocess
from pathlib import Path


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--publish", action="store_true")
    parser.add_argument("--allow-dirty", action="store_true")
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    metadata = json.loads(subprocess.run(
        ["cargo", "metadata", "--no-deps", "--format-version", "1"],
        cwd=root, capture_output=True, text=True, check=True,
    ).stdout)
    ignored = metadata["metadata"].get("conta", {}).get("ignore")
    if ignored is None:
        parser.error("run script/prepare-publish first")
    members = set(metadata["workspace_members"])
    packages = sorted(package["name"] for package in metadata["packages"]
                      if package["id"] in members and package["name"] not in ignored)
    if not packages or any(not name.startswith("bezel-") for name in packages):
        parser.error("publish plan contains unprepared packages")
    command = ["cargo", "publish"]
    for name in packages:
        command.extend(["--package", name])
    if args.allow_dirty:
        command.append("--allow-dirty")
    subprocess.run([*command, "--dry-run"], cwd=root, check=True)
    if args.publish:
        subprocess.run(command, cwd=root, check=True)


if __name__ == "__main__":
    main()
